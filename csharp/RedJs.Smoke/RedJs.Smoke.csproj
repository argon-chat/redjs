<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RedJs.Smoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedJs\RedJs.csproj" />
  </ItemGroup>

  <!-- NativeAOT smoke: `dotnet publish -r win-x64 -p:PublishAot=true` static-links
       the thin redjs.lib + the WebKit archives (see packages/jscore/README.md). -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="redjs" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\..\lib\win-x64\redjs.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\..\prebuilt\bun-webkit\lib\JavaScriptCore.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\..\prebuilt\bun-webkit\lib\WTF.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\..\prebuilt\bun-webkit\lib\bmalloc.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\..\prebuilt\bun-webkit\lib\sicudt.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\..\prebuilt\bun-webkit\lib\sicuin.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\..\prebuilt\bun-webkit\lib\sicuuc.lib" />
    <LinkerArg Include="shell32.lib" />
    <LinkerArg Include="ole32.lib" />
    <LinkerArg Include="oleaut32.lib" />
    <LinkerArg Include="shlwapi.lib" />
    <LinkerArg Include="winmm.lib" />
    <LinkerArg Include="dbghelp.lib" />
    <LinkerArg Include="usp10.lib" />
    <LinkerArg Include="synchronization.lib" />
    <LinkerArg Include="userenv.lib" />
    <LinkerArg Include="ws2_32.lib" />
    <LinkerArg Include="rpcrt4.lib" />
    <LinkerArg Include="crypt32.lib" />
  </ItemGroup>

</Project>
