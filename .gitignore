# Bun WebKit prebuilt (fetched by setup.ps1, ~1.1 GB)
prebuilt/

# yoga C++ sources for the native layout backend (fetched by `bun run fetch:yoga`, pinned by commit).
# Upstream code we never patch — vendoring it into history would make every version bump read as a
# 5000-line diff. The MIT notice is committed separately as cpp/yoga-LICENSE.txt, since the compiled
# result ships inside the player.
redjs/cpp/yoga/

# Built artifacts (produced by build.ps1; consumers link these)
runtimes/
lib/

# Rust build output
redjs/target/

# .NET build output (was covered by the monorepo root .gitignore before the
# submodule split — the standalone repo must ignore it itself)
csharp/**/bin/
csharp/**/obj/
csharp/codegen/target/
